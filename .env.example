# === 複製這個檔案成 .env，再填入你自己的值。.env 絕對不要提交到 git ===

# 服務埠號
PORT=3000

# Session 簽章用的隨機字串。務必改成你自己的，可用下列指令產生：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=請務必改成隨機字串

# 第一次啟動時要建立的管理員帳號（建立後請刪掉這兩行，密碼只會被雜湊存入資料庫）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=請改成至少12碼的強密碼

# 農業部農產品交易行情 API
# 官方文件：https://data.moa.gov.tw/open_detail.aspx?id=037
MOA_API_URL=https://data.moa.gov.tw/api/v1/AgriProductsTransType/
# 有些端點需要申請金鑰，沒有就留空
MOA_API_KEY=
# 要對照的批發市場名稱（例：台北一、台北二、三重）
MOA_MARKET=台北一

# 正式環境設為 production，Cookie 會加上 Secure 旗標（需搭配 HTTPS）
NODE_ENV=development

# === 金流（尚未啟用，串接時才填）===
# 綠界 ECPay
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
